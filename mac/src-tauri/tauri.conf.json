{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Compass",
  "version": "0.1.0",
  "identifier": "com.knocturnlabs.compass",
  "build": {
    "frontendDist": "https://compass.knocturnlabs.com"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.productivity",
    "copyright": "Knocturn Labs",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["compass"]
      }
    }
  }
}
