{
  "name": "compass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8790 --local-upstream localhost:8790",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "check": "for f in scripts/*.test.ts; do [ -e \"$f\" ] || continue; node --experimental-strip-types \"$f\" || exit 1; done",
    "build": "npm run typecheck && vite build",
    "deploy:preview": "npm run build && wrangler versions upload",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply compass-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply compass-db --remote",
    "gen-secret": "node scripts/gen-secret.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.125.0"
  }
}
