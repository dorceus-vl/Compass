{
  "name": "compass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "library": "node scripts/library-build.mjs",
    "dev": "npm run library && vite",
    "dev:worker": "npm run library && mkdir -p dist && wrangler dev --test-scheduled --port 8790 --local-upstream localhost:8790",
    "typecheck": "npm run library && tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "check": "for f in scripts/*.test.ts; do [ -e \"$f\" ] || continue; node --experimental-strip-types \"$f\" || exit 1; done",
    "build": "npm run typecheck && vite build",
    "deploy:preview": "npm run build && wrangler versions upload",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply compass-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply compass-db --remote",
    "gen-secret": "node scripts/gen-secret.mjs",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "docx": "^9.12.0",
    "docxtemplater": "^3.71.1",
    "fflate": "^0.8.3",
    "hono": "^4.6.14",
    "pizzip": "^3.3.0",
    "postal-mime": "^4.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.125.0"
  }
}
