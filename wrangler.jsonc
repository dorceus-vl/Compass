{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compass",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "observability": { "enabled": true },
  // The built app (dist/) is static and holds no data; only /api/* runs the Worker. Any other path is the app.
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "compass-db", "database_id": "3820b4a9-ed77-4cea-915c-9c1c2af40491", "migrations_dir": "worker/migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "compass-files" }],
  "services": [{ "binding": "ID", "service": "knocturn-id" }],
  "vars": {
    "COMPASS_USERS": "7cad1bd5-760b-4423-9b02-406c74d5a6e4,ab39fa67-0a88-40b6-824b-9718500e5f47",
    "ID_URL": "https://id.knocturnlabs.com",
    "VAPID_SUBJECT": "mailto:vladimir.bigvlad@gmail.com",
    "DEV_LOGIN": "0",
    // Phase 3 copilot (worker/lib/ai.ts). Keys are secrets Vlad puts himself: ANTHROPIC_API_KEY, GEMINI_API_KEY.
    "AI_MODEL_CLAUDE": "claude-sonnet-5-5",
    "AI_MODEL_GEMINI": "gemini-3.6-flash",
    // USD per million tokens; update when a provider changes prices.
    "AI_PRICES": "{\"claude\":{\"in\":3,\"out\":15},\"gemini\":{\"in\":0.75,\"out\":3.75}}"
  },
  // Every 15 minutes: Trash purge (30 days), audit purge (90 days). Later phases add pushes here.
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [{ "pattern": "compass.knocturnlabs.com", "custom_domain": true }]
  // Secrets (wrangler secret put): COMPASS_DATA_KEY; Phase 2: INBOX_SECRET_KELLY/ID/HOLLOW, VAPID_PUBLIC_KEY/PRIVATE_KEY, EMAIL_INBOX_ADDRESS, ALLOWED_FORWARDERS (scripts/setup-phase2.sh).
}
