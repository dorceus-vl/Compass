<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Knocturn ID sends the sign-in answer here: compass://auth?code=…&state=… (CompassNativePlugin.signIn) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="compass" android:host="auth" />
            </intent-filter>

            <!-- App Links: Compass's pages open in the app (Compass serves /.well-known/assetlinks.json, N5) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="compass.knocturnlabs.com" />
            </intent-filter>

            <!-- Share text or a link to Compass: it opens quick add, prefilled (N4) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Capacitor's file chooser uses it for photos taken from <input type="file"> -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Push: only does anything in a build with google-services.json (app/build.gradle) -->
        <service android:name=".CompassMessaging" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="compass" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_notification" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/compass_accent" />

        <!-- Widgets (v2.3, Task 2b): one provider per widget (WidgetProviders), drawn from the snapshot the page writes. The system's
             AppWidgetService delivers their updates, so none is exported. -->
        <receiver android:name=".widgets.WidgetProviders$TodaySmall" android:label="@string/widget_today_small" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_small_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetProviders$TodayMedium" android:label="@string/widget_today_medium" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_medium_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetProviders$TodayLarge" android:label="@string/widget_today_large" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_large_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetProviders$QuickAdd" android:label="@string/widget_quick_add" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_add_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetProviders$AskAthena" android:label="@string/widget_ask_athena" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_ask_athena_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetProviders$ProjectPulse" android:label="@string/widget_pulse" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pulse_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetProviders$Week" android:label="@string/widget_week" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_week_info" />
        </receiver>
        <!-- Local midnight: the widgets redraw so "Today" rolls over (one inexact alarm, re-armed at each draw; no alarm permission). -->
        <receiver android:name=".widgets.WidgetProviders$Midnight" android:exported="false" />
        <!-- A widget's tick circle: reached only through the app's own PendingIntents (explicit, immutable). -->
        <receiver android:name=".widgets.TickReceiver" android:exported="false" />
        <!-- Project pulse's picker: the launcher starts it with the widget's id; it only sets a Project pulse widget of this app. -->
        <activity android:name=".widgets.ProjectPulseConfigActivity" android:exported="true" android:theme="@android:style/Theme.Material.Dialog"
            android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Athena's mic (Phase 5b): the web view's audio capture, granted only to the Compass page (MainActivity, CompassLink.mayCapture) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
