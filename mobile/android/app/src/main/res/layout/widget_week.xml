<?xml version="1.0" encoding="utf-8"?>
<!-- This week (5x3 and up, resizable; tablets): the week as a strip of days, then open tasks with ticks and the projects. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_bg" android:padding="12dp">
    <include layout="@layout/widget_head" />
    <LinearLayout android:id="@+id/days" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="6dp" android:orientation="horizontal" />
    <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="vertical" />
</LinearLayout>
